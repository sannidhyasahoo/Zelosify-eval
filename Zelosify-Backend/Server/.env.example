# PSQL Database Configuration
DATABASE_URL="postgresql://username:secure_password@your-postgres-host:5432/zelosify_db?schema=app"

# JWT Secret for Session & Tokens (Must be a cryptographically secure 32+ character secret)
JWT_SECRET="your_cryptographically_secure_jwt_secret_here"

# AES-256-GCM Encryption Key (64 hex characters / 32 bytes)
ENCRYPTION_ALGORITHM="aes-256-gcm"
ENCRYPTION_KEY="your_64_character_hex_encryption_key_here"

# Node Environment
NODE_ENV="production"

# Storage Configuration
STORAGE_PROVIDER="aws"

# AWS S3 Storage Credentials
S3_AWS_REGION="us-east-1"
S3_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
S3_BUCKET_NAME="your-production-bucket-name"

# Keycloak Identity & Access Management
KEYCLOAK_URL="https://auth.yourdomain.com/auth"
KEYCLOAK_ADMIN="your_keycloak_admin_user"
KEYCLOAK_ADMIN_PASSWORD="YOUR_KEYCLOAK_ADMIN_PASSWORD"
KEYCLOAK_REALM="Zelosify"
KEYCLOAK_CLIENT_ID="zelosify-production-client"
KEYCLOAK_CLIENT_SECRET="YOUR_KEYCLOAK_CLIENT_SECRET"
KEYCLOAK_RS256_SIG="YOUR_KEYCLOAK_RS256_PUBLIC_KEY"

# Session Secret
SESSION_SECRET="your_cryptographically_secure_session_secret_here"

# Server Configuration
PORT=5000
FRONTEND_URL="https://app.yourdomain.com"

# AI LLM Provider Configuration (Choose Groq or Google Gemini)
# GROQ_API_KEY="gsk_your_groq_api_key_here"
GEMINI_API_KEY="your_production_gemini_api_key_here"
# GOOGLE_API_KEY="your_google_api_key_here"
